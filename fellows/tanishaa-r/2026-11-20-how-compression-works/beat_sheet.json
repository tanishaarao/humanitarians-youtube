    {
      "beat_id": "B01",
      "act": "BLUF",
      "narration_text": "A zipped file is smaller, but when you open it, every letter comes back. A photo shrinks even more, because it learns to throw away what you won't notice.",
      "voice": "af_bella",
      "engine": "kokoro",
      "speed": 0.95,
      "estimated_duration_s": 12,
      "shot": {
        "type": "REMOTION",
        "source": "own",
        "remotion": {
          "pattern": "CmpHook",
          "props": {
            "shrinkAt": 0.0384,
            "points": [
              {
                "text": "every letter comes back",
                "at": 0.2831
              },
              {
                "text": "throw away what you won't notice",
                "at": 0.7624,
                "accent": true
              }
            ],
            "durationSeconds": 9.89
          }
        }
      },
      "audio_file": "mp3/beat-B01.mp3",
      "actual_duration_s": 9.49,
      "render_duration_s": 9.5,
      "build": {
        "status": "VIDEO",
        "src": "media/B01.mp4",
        "filled_by": "media",
        "at": "2026-11-20T15:59:13"
      }
    },
    {
      "beat_id": "B02",
      "act": "FRAMEWORK",
      "narration_text": "There are two kinds. Lossless compression, like ZIP and PNG, gives you back every bit. Lossy compression, like JPEG and MP3, drops detail to get much smaller.",
      "voice": "af_bella",
      "engine": "kokoro",
      "speed": 0.95,
      "estimated_duration_s": 14,
      "shot": {
        "type": "REMOTION",
        "source": "own",
        "remotion": {
          "pattern": "CmpColumns",
          "props": {
            "left": {
              "header": "Lossless",
              "at": 0.122,
              "items": [
                {
                  "text": "like ZIP and PNG",
                  "at": 0.2095
                },
                {
                  "text": "gives you back every bit",
                  "at": 0.38
                }
              ]
            },
            "right": {
              "header": "Lossy",
              "at": 0.5332,
              "items": [
                {
                  "text": "like JPEG and MP3",
                  "at": 0.5864
                },
                {
                  "text": "drops detail",
                  "at": 0.7787
                }
              ]
            },
            "card": "",
            "cardAt": 0.99,
            "durationSeconds": 12.79
          }
        }
      },
      "audio_file": "mp3/beat-B02.mp3",
      "actual_duration_s": 12.39,
      "render_duration_s": 12.416666666666666,
      "build": {
        "status": "VIDEO",
        "src": "media/B02.mp4",
        "filled_by": "media",
        "at": "2026-11-20T15:59:13"
      }
    },
    {
      "beat_id": "B03",
      "act": "MECHANISM",
      "narration_text": "The first lossless trick is spotting repeats. Take one line from Row, Row, Row Your Boat. The compressor writes the first ten letters, then just one note: go back nine, copy twenty-five. That's how ZIP and PNG both work underneath.",
      "voice": "af_bella",
      "engine": "kokoro",
      "speed": 0.95,
      "estimated_duration_s": 19,
      "shot": {
        "type": "REMOTION",
        "source": "own",
        "remotion": {
          "pattern": "CmpRepeat",
          "props": {
            "source": "Row, Row, Row Your Boat",
            "line": "Merrily, merrily, merrily, merrily,",
            "literals": 10,
            "back": 9,
            "len": 25,
            "lineAt": 0.1708,
            "literalsAt": 0.4441,
            "noteAt": 0.6113,
            "tailAt": 0.7644,
            "tail": "That's how ZIP and PNG both work underneath.",
            "durationSeconds": 16.98
          },
          "rendered": {
            "out": "media/B03.mp4",
            "at": "2026-11-20T20:57:26.796450+00:00"
          }
        }
      },
      "audio_file": "mp3/beat-B03.mp3",
      "actual_duration_s": 16.58,
      "render_duration_s": 16.583333333333332,
      "build": {
        "status": "VIDEO",
