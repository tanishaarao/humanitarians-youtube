        "filled_by": "media",
        "at": "2026-11-20T15:59:13"
      }
    },
    {
      "beat_id": "B07",
      "act": "MECHANISM",
      "narration_text": "JPEG works differently. It cuts a photo into eight by eight blocks. In each block it keeps the broad changes and drops fine detail your eyes barely notice. Your eyes notice brightness more than colour, so colour gets squeezed hardest.",
      "voice": "af_bella",
      "engine": "kokoro",
      "speed": 0.95,
      "estimated_duration_s": 19,
      "shot": {
        "type": "REMOTION",
        "source": "own",
        "remotion": {
          "pattern": "CmpBlocks",
          "props": {
            "photo": "compression/original.png",
            "blocksAt": 0.1727,
            "keepAt": 0.3516,
            "dropAt": 0.4461,
            "colourAt": 0.6541,
            "durationSeconds": 15.87
          }
        }
      },
      "audio_file": "mp3/beat-B07.mp3",
      "actual_duration_s": 15.47,
      "render_duration_s": 15.5,
      "build": {
        "status": "VIDEO",
        "src": "media/B07.mp4",
        "filled_by": "media",
        "at": "2026-11-20T15:59:13"
      }
    },
