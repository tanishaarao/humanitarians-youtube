    {
      "beat_id": "B09",
      "act": "WHEN NOT TO",
      "narration_text": "So which should you use? Text and code need lossless, because one wrong bit breaks them. Line drawings and screenshots stay sharp as PNG. Photos and music are fine with lossy. And edit the original, not a JPEG of a JPEG, because every re-save loses a little more.",
      "voice": "af_bella",
      "engine": "kokoro",
      "speed": 0.95,
      "estimated_duration_s": 20,
      "shot": {
        "type": "REMOTION",
        "source": "own",
        "remotion": {
          "pattern": "CmpColumns",
          "props": {
            "left": {
              "header": "Lossless",
              "at": 0.0732,
              "items": [
                {
                  "text": "text and code",
                  "at": 0.0732
                },
