    },
    {
      "beat_id": "B03",
      "act": "FRAMEWORK",
      "narration_text": "But detail still matters. The guide puts it this way: fewer details mean more variety, but less control. So the real trick is the right details, not more words.",
      "voice": "af_bella",
      "engine": "kokoro",
      "speed": 0.95,
      "estimated_duration_s": 14,
      "shot": {
        "type": "REMOTION",
        "source": "own",
        "remotion": {
          "pattern": "PrmSlider",
          "props": {
            "fewerAt": 0.3181,
            "lessAt": 0.5147,
            "rightAt": 0.7382,
            "fewer": "fewer details mean more variety",
            "less": "but less control",
            "right": "the right details, not more words",
            "durationSeconds": 11.19
          }
        }
      },
      "audio_file": "mp3/beat-B03.mp3",
      "actual_duration_s": 10.79,
      "render_duration_s": 10.791666666666666,
