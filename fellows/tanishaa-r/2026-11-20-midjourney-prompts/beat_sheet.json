    {
      "beat_id": "B02",
      "act": "PROBLEM",
      "narration_text": "Midjourney's own guide says short, clear prompts usually work best. Long lists and instructions can confuse it. Its example turns a whole request into one line: colored pencil illustration of bright orange California poppies.",
      "voice": "af_bella",
      "engine": "kokoro",
      "speed": 0.95,
      "estimated_duration_s": 18,
      "shot": {
        "type": "REMOTION",
        "source": "own",
        "remotion": {
          "pattern": "PrmExample",
          "props": {
            "guideAt": 0.019,
            "shortLabel": "short, clear prompts usually work best",
            "shortAt": 0.071,
            "longLabel": "long lists and instructions can confuse it",
            "longAt": 0.2902,
            "longPrompt": "Show me a picture of lots of blooming California poppies, make them bright, vibrant orange, and draw them in an illustrated style with colored pencils",
            "shortPrompt": "Colored pencil illustration of bright orange California poppies",
            "exampleAt": 0.4854,
            "source": "Midjourney, Prompt Basics (their own example)",
            "durationSeconds": 15.78
          }
        }
      },
      "audio_file": "mp3/beat-B02.mp3",
      "actual_duration_s": 15.38,
      "render_duration_s": 15.416666666666666,
      "build": {
        "status": "VIDEO",
